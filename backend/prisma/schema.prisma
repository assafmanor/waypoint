// Waypoint data model — implements docs/architecture/data-model.md.
// Keep in sync with packages/shared/src/entities.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts, not here.
}

// Which picture source the user chose (ADR-0133 §4/§6). `initials` is precisely
// "chose not to use a photo" — the state that makes the hue a real choice.
enum AvatarChoice {
  google
  upload
  initials
}

enum AuthProvider {
  google
}

enum EventKind {
  hard
  soft
}

enum EventStatus {
  planned
  done
  skipped
}

enum TaskStatus {
  open
  done
  dismissed
}

enum EventSource {
  manual
  gmail
  maybe_shelf
  integration
}

enum BookingType {
  flight
  hotel
  restaurant
  train
  transit
  car
  activity
  other
}

// Canonical semantic type of a timeline item (ADR-0038). The `icon` glyph is
// only its badge; BookingType and map-pin colours derive from this.
enum EventCategory {
  transport
  food
  lodging
  sightseeing
  nature
  activity
  shopping
  services
  other
}

enum BookingSource {
  manual
  gmail
}

enum MembershipRole {
  admin
  peer
}

// Append-only, so this lists the values in the ORDER POSTGRES HOLDS THEM, which is not
// the order they are shown in (`DOCUMENT_TYPE` in @waypoint/shared owns that).
enum DocumentType {
  passport
  insurance
  visa
  ticket
  reservation
  license
  health
  other
}

enum ChangeAction {
  create
  update
  move
  delete
  status
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  displayName       String
  // Identity (ADR-0133). `avatarHue` stores a ramp KEY, not a hex, so the dark
  // token remap reaches it — and it is NULLABLE on purpose: null means "never
  // chosen", which the server resolves per-user via `deriveAvatarHue(id)`. It
  // replaces `avatarColor String @default("#E9A63C")`, whose single column
  // default is exactly what made every real user the same colour.
  avatarHue         String?
  avatarChoice      AvatarChoice @default(initials)
  // The provider's `picture`, refreshed at each sign-in. Kept even while the user
  // is on `initials`, so "use my Google photo" has somewhere to come back from.
  googleAvatarUrl   String?
  uploadedAvatarKey String? // set by ADR-0133's Phase 4 only
  // The member's HOME currency (ADR-0184 §2) — the other side of every trip
  // conversion. Nullable because "never chosen" is a real state the client
  // resolves for itself from the device region, through the same
  // COUNTRY_CURRENCY table the trip's own currency is derived from. A column
  // default would be the mistake `avatarColor` already made here: one value
  // that is wrong for everyone outside the country that picked it.
  preferredCurrency String?
  // **Which categories of notification this person wants** (ADR-0198 §6). On `User` and not
  // on `PushSubscription`, so they follow a person to a new phone the way
  // `preferredCurrency` does: the subscription is per DEVICE, the preference is per person.
  //
  // Default `true`, and that is not an opt-in by stealth — the real opt-in is the device's
  // own permission, which nothing here can grant. A person who has allowed notifications
  // and then finds task reminders switched off would be looking at a switch that lied.
  //
  // Phases A and B. `notifyGroup` arrives only if phase D is ever built (ADR-0198 §6,
  // amended 2026-08-21) — an unused column would be a preference for a feature that may
  // never come.
  notifyTasks       Boolean  @default(true)
  // Phase B: hard events, span edges, and the evening-before send. A separate switch from
  // `notifyTasks` because they are different registers — one is what a person wrote down,
  // the other is what the itinerary already committed them to. Somebody may well want the
  // flight and not the chores.
  notifyObligations Boolean  @default(true)

  createdAt DateTime @default(now())

  authIdentities      AuthIdentity[]
  sessions            Session[]
  memberships         Membership[]
  tripsCreated        Trip[]
  maybeItems          MaybeItem[]
  changes             Change[]
  calendarEventLinks  CalendarEventLink[]
  tripBlocks          TripBlock[]
  notes               Note[]
  tasks               Task[]
  documentAttachments DocumentAttachment[]
  pushSubscriptions   PushSubscription[]
  notificationSends   NotificationSend[]
}

// Provider identity + that provider's OAuth material, one per (user, provider). ADR-0020.
model AuthIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  refreshTokenEnc   String? // encrypted at rest (ADR-0015)
  scopes            String[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Rotating refresh-token store (ADR-0020).
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Trip {
  id                       String   @id @default(cuid())
  name                     String
  destination              String
  // Structured destination from the creation Places pick (ADR-0113); `destination`
  // stays the display string. Nullable — trips created before ADR-0113 have none.
  destinationGooglePlaceId String?
  destinationLat           Float?
  destinationLng           Float?
  destinationCountryCode   String?
  startDate                DateTime @db.Date
  endDate                  DateTime @db.Date
  timezone                 String   @default("UTC")
  currency                 String?
  icon                     String?
  createdBy                String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  updatedBy                String

  creator     User         @relation(fields: [createdBy], references: [id])
  memberships Membership[]
  events      Event[]
  bookings    Booking[]
  documents   Document[]
  maybeItems  MaybeItem[]
  places      Place[]
  changes     Change[]
  invite      Invite?
  blocks      TripBlock[]
  notes       Note[]
  tasks       Task[]

  documentAttachments DocumentAttachment[]

  @@index([createdBy])
}

// One durable, revocable invite per trip (ADR-0067). The short random `code` is
// both the public handle in /join/<code> and the grant itself — join resolves
// code → row → tripId (no separate token). Rotating mints a fresh code in place,
// so the old one stops resolving. Validity is until the trip ends (checked live
// against Trip.endDate) or an admin rotates; no fixed timer.
model Invite {
  id        String   @id @default(cuid())
  tripId    String   @unique
  code      String   @unique
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// A user barred from rejoining a trip via its invite (ADR-0067). Written when an
// admin removes another member (not on a self-leave); checked at join. Gates
// joining only — all access stays gated by Membership.
model TripBlock {
  tripId    String
  userId    String
  blockedBy String
  blockedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
}

model Membership {
  id                  String         @id @default(cuid())
  tripId              String
  userId              String
  role                MembershipRole @default(peer)
  calendarSyncEnabled Boolean        @default(false)
  joinedAt            DateTime       @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  // getMe / listForUser filter by userId alone; the composite unique above leads
  // with tripId, so those scan without this (backend-review B-09).
  @@index([userId])
}

model Event {
  id              String         @id @default(cuid())
  tripId          String
  date            DateTime       @db.Date
  endDate         DateTime?      @db.Date // non-null = multi-day ambient span (ADR-0018)
  title           String
  icon            String?
  category        EventCategory?
  kind            EventKind
  startsAt        DateTime? // UTC instant
  endsAt          DateTime?
  // The other bound of a flexible edge's window (ADR-0184). A held span's start is
  // already a floor and its end a deadline (ADR-0171 §1); these close them, so a
  // check-in reads 17:00–21:00 instead of "from 17:00". Instants, not HH:MM, so a
  // reception open until 01:00 works and the display-zone derivation is unchanged.
  startWindowEnd  DateTime? // latest a check-in / pick-up can happen
  endWindowStart  DateTime? // earliest a check-out / return can happen
  placeId         String? // authoritative only for unlinked events; cleared when bookingId is set (ADR-0048)
  displayTimezone String? // manual display-zone override; null trusts the derived zone (ADR-0107 §7)
  status          EventStatus    @default(planned)
  bookingId       String?        @unique // strict 1:1 with Booking (ADR-0047)
  sortOrder       Int            @default(0)
  source          EventSource    @default(manual)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  updatedBy       String

  trip                Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking             Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  notes               Note[]
  tasks               Task[]
  place               Place?               @relation("EventPlace", fields: [placeId], references: [id], onDelete: SetNull)
  calendarLinks       CalendarEventLink[]
  documentAttachments DocumentAttachment[]

  @@index([tripId, date])
  /// The same reason as `Task`'s: a kind asking "which hard commitments start soon, anywhere"
  /// is a range scan on this, and every other index here leads with `tripId`, which a
  /// cross-trip query cannot use.
  @@index([startsAt])
}

model Booking {
  id                   String        @id @default(cuid())
  tripId               String
  type                 BookingType
  title                String
  confirmationCode     String?
  provider             String?
  placeId              String? // single-place types (hotel/restaurant/…); mutually exclusive with from/to
  fromPlaceId          String? // transport origin (map-pin/nav target of the linked Event) — ADR-0048
  toPlaceId            String? // transport destination — ADR-0048
  // Per-end display-zone overrides (ADR-0107): start = transport origin / the single
  // place; end = transport destination. Null trusts the derivation.
  startDisplayTimezone String?
  endDisplayTimezone   String?
  details              Json?
  source               BookingSource @default(manual)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  updatedBy            String

  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  event     Event? // strict 1:1 (Event.bookingId @unique, ADR-0047)
  place     Place? @relation("BookingPlace", fields: [placeId], references: [id], onDelete: SetNull)
  fromPlace Place? @relation("BookingFromPlace", fields: [fromPlaceId], references: [id], onDelete: SetNull)
  toPlace   Place? @relation("BookingToPlace", fields: [toPlaceId], references: [id], onDelete: SetNull)
  notes     Note[]
  tasks     Task[]

  documentAttachments DocumentAttachment[]

  @@index([tripId])
}

// Trip-scoped location registry (ADR-0048). Name-only rows are valid ("Place-lite");
// googlePlaceId/lat/lng/timezone/rating are filled in later by the Google Places
// picker on a pick (ADR-0108). The row *is* the enrichment cache — dedup-before-spend
// keys on @@unique([tripId, googlePlaceId]) so a place is enriched at most once per trip
// (Postgres treats NULLs as distinct, so many name-only rows still coexist).
model Place {
  id               String         @id @default(cuid())
  tripId           String
  googlePlaceId    String?
  name             String
  address          String?
  lat              Float?
  lng              Float?
  timezone         String? // IANA zone, resolved once server-side via geo-tz (ADR-0107/0108)
  // The glyph a human chose for this place (ADR-0147). Bottom of the icon resolution chain,
  // and the reason a Place stays trip-scoped rather than a shared cross-trip record: a chosen
  // icon is data about this trip's view of the place, not about the entity Google describes.
  icon             String?
  // The short label a human chose for this place (ADR-0166 §18, field report #23). Same
  // argument as `icon` below it: user-authored, trip-scoped, and it must survive deleting the
  // idea it was written through. Display-only — `name` still holds the official name — and it
  // is the manual override for the cases `P931` cannot resolve (Ben Gurion serves Tel Aviv
  // AND Jerusalem at equal rank).
  nickname         String?
  // What a human said this place IS (ADR-0165). Same argument as `icon` above — it has to
  // survive deleting the idea it was written through — and it is why the map's category pills
  // are no longer a control with nowhere to write.
  category         EventCategory?
  rating           Float? // Google aggregate rating 0–5 (ADR-0109 §9)
  userRatingsTotal Int? // count behind `rating`
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  updatedBy        String

  trip         Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  events       Event[]     @relation("EventPlace")
  bookings     Booking[]   @relation("BookingPlace")
  bookingsFrom Booking[]   @relation("BookingFromPlace")
  bookingsTo   Booking[]   @relation("BookingToPlace")
  maybeItems   MaybeItem[] @relation("MaybeItemPlace")
  notes        Note[]
  tasks        Task[]

  @@unique([tripId, googlePlaceId])
  @@index([tripId])
}

// Idempotency map for one-way calendar push, per member per event (ADR-0020).
model CalendarEventLink {
  id                    String   @id @default(cuid())
  eventId               String
  userId                String
  googleCalendarEventId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Document {
  id          String       @id @default(cuid())
  tripId      String
  type        DocumentType
  title       String
  fileRef     String // reference to a server-side-encrypted blob (ADR-0015)
  mimeType    String
  sizeBytes   Int
  ownerUserId String? // null = group doc
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  updatedBy   String

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  notes Note[]
  tasks Task[]

  attachments DocumentAttachment[]

  @@index([tripId])
}

// **The link between a document and the booking or event it belongs to** (ADR-0173 §1).
// A row of its own rather than a host FK on Document, and the cascades are the whole
// argument: deleting the DOCUMENT takes its links (the file is gone, so the pointers are
// meaningless), and deleting the HOST takes the link and cannot reach the document —
// it is a separate row, still owned by the trip. A cancelled hotel must not delete your
// voucher, and with this shape that is the DEFAULT behaviour rather than a `SetNull`
// special case someone later "fixes".
//
// Many-to-many, which is a requirement and not generality: ADR-0154 fixes a round trip as
// two Bookings, and one confirmation PDF covers both.
model DocumentAttachment {
  id         String   @id @default(cuid())
  tripId     String
  documentId String
  // Exactly one is set — enforced by the shared zod schema at both edges (ADR-0023), since
  // the union is closed and Prisma's schema language cannot express a check constraint.
  // There is deliberately no `placeId`: a place displays an inherited attachment and may
  // never originate one (ADR-0173 §4), so its inheritance is read-time only.
  eventId    String?
  bookingId  String?
  createdBy  String
  createdAt  DateTime @default(now())

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event    Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // One document attaches to one host once. TWO constraints rather than one over three
  // columns, because Postgres treats NULLs as distinct: each binds only the rows where its
  // host is actually set, and between them every row is covered. What they buy is that a
  // double-tap or an outbox replay is a duplicate-key hit the service reads as
  // already-applied, rather than a second row nobody can tell from the first.
  @@unique([documentId, eventId])
  @@unique([documentId, bookingId])
  @@index([tripId])
  @@index([documentId])
  @@index([eventId])
  @@index([bookingId])
}

model MaybeItem {
  id         String         @id @default(cuid())
  tripId     String
  title      String
  icon       String?
  category   EventCategory?
  placeId    String?
  // The day we're thinking of, pencilled in (ADR-0116 §1) — never a schedule: an
  // idea with a target day still carries no time and never reaches the timeline.
  targetDate String?
  createdBy  String
  consumed   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  updatedBy  String

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  place Place? @relation("MaybeItemPlace", fields: [placeId], references: [id], onDelete: SetNull)
  notes Note[]
  tasks Task[]

  @@index([tripId])
}

// A note is ONE entity and what it is about is a field (ADR-0152 §1). No host = a general
// note; exactly one of the five FKs set = that entity's note — same row, same editor, same
// list, same sync channel either way.
//
// Every host FK is `onDelete: Cascade`, which is the STORAGE guarantee and deliberately not
// the sync one: a database cascade deletes these rows WITHOUT writing `Change` rows, so the
// clients are told by a rule in the ADR-0094 appliers keyed off `NOTE_HOST_FIELD` instead
// (ADR-0152 §2). Typed FKs rather than a `targetType`/`targetId` pair so orphan cleanup is
// the database's job in one place rather than application logic in five delete paths; the
// accepted cost is a migration when a sixth entity becomes note-bearing.
//
// `category` is nullable and STAYS null on a hosted note — it resolves from the host at
// render (§5's amendment). There is no `icon` column: the same chain gives the glyph.
model Note {
  id          String         @id @default(cuid())
  tripId      String
  title       String?
  body        String?
  url         String?
  category    EventCategory?
  // At most one of these is set — enforced by the shared zod schema at both edges
  // (ADR-0023), since the union is closed and a check constraint here could not be
  // expressed through Prisma's schema language.
  eventId     String?
  bookingId   String?
  placeId     String?
  maybeItemId String?
  documentId  String?
  source      String         @default("member")
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  updatedBy   String

  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  place     Place?     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  maybeItem MaybeItem? @relation(fields: [maybeItemId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // The five host indexes are what make "this row's notes" a lookup rather than a scan —
  // the mark on every row of a day asks that question once per host.
  @@index([tripId])
  @@index([eventId])
  @@index([bookingId])
  @@index([placeId])
  @@index([maybeItemId])
  @@index([documentId])
}

// A task is an obligation with a deadline and optionally a doer (tasks brief §1). Notes'
// sibling structurally — same host block, same cascade discipline (ADR-0152 §2).
model Task {
  id              String     @id @default(cuid())
  tripId          String
  title           String
  body            String?
  // The deadline as a UTC instant. `dueHasTime` is not derivable from it: a deadline of
  // "Thursday" and one of "Thursday 00:00" are the same instant and different obligations.
  dueAt           DateTime?
  dueHasTime      Boolean    @default(false)
  // The zone the deadline was TYPED in (2026-08-17, reversing brief §10's "nothing is
  // stored per task"). Null = derived through ADR-0107's resolver, which is every task
  // written before this. Deriving is right until somebody can CHOOSE, and then a resolver
  // that answers "the zone you will be in when this falls due" renders a wall-clock nobody
  // typed — which is exactly what `Event.displayTimezone` exists to prevent.
  displayTimezone String?
  // Null = the group's ("one of us"). A plain column rather than a User relation, like
  // `Event.updatedBy`: the trip's roster is what resolves a name, and a FK here would owe
  // a cascade answer for a case (the assignee's account is deleted) nobody has asked.
  assigneeUserId  String?
  // **When somebody ELSE put this on the assignee** (ADR-0198 §2, `task.assigned`).
  //
  // A transition, not a clock — which is why it has to be stored. ADR-0197 §3 derives every
  // schedule from state rather than enqueueing it, and that works because a deadline IS a
  // state; "you were just assigned this" is not, and no combination of `updatedAt` and
  // `assigneeUserId` can tell it from a title edit. So the FACT is recorded and the send is
  // still derived, which keeps §3's principle rather than bending it.
  //
  // **Null when the actor assigned themselves**, so the "the actor is not the assignee" rule
  // is applied where the actor is actually known instead of being guessed from `updatedBy`
  // by the sweep. Null also on un-assign, which retracts a send that has not gone out yet.
  // Null on every task written before this column, which is the right answer: we do not
  // announce an assignment that happened before anyone could be told.
  assignedAt      DateTime?
  important       Boolean    @default(false)
  status          TaskStatus @default(open)
  settledAt       DateTime?
  settledBy       String?
  // Which readiness check this row overlays (brief §4). A String and NOT a Prisma enum on
  // purpose: the five ids belong to `computeReadiness`, so a sixth check must be a code
  // change and never a migration. The closed set is enforced by the shared zod schema at
  // both edges (ADR-0023), the same way the host union below is.
  derivedKey      String?
  // **The task this one is a step of** (ADR-0196 §1). Null = a top-level task, which is
  // every task written before this. `onDelete: Cascade` on the relation below, so deleting a
  // parent takes its steps with it in one statement — and, exactly like the five host FKs,
  // that cascade writes NO `Change` rows, which is why the client owes its own applier
  // (`dropTasksForHostChange`, ADR-0152 §2 extended by ADR-0157 §3).
  //
  // Depth is capped at one level and the SERVER enforces it: `TasksService.create` refuses a
  // parent that is itself a step. A self-relation cannot express that, and a client-only cap
  // is one the outbox can replay past.
  parentTaskId    String?
  // At most one is set — the same closed union `Note` carries, enforced the same way.
  // Nothing reads these until phase 4; they are here in the first migration because a
  // nullable column is free today and a second migration on a live synced entity is not.
  eventId         String?
  bookingId       String?
  placeId         String?
  maybeItemId     String?
  documentId      String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedBy       String

  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  place     Place?     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  maybeItem MaybeItem? @relation(fields: [maybeItemId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // The self-relation. Named, because Prisma needs a name to tell the two sides apart.
  parent    Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks  Task[]     @relation("TaskSubtasks")

  @@index([tripId])
  @@index([eventId])
  @@index([bookingId])
  @@index([placeId])
  @@index([maybeItemId])
  @@index([documentId])
  @@index([parentTaskId])
  /// **The notification sweep's index** (ADR-0197 §3). The sweep asks "which deadlines fall
  /// in this narrow window, across every trip" — one range scan, not a walk over trips — and
  /// without this it is a full table scan every minute forever. `status` leads because it is
  /// the selective half: most rows are settled and can never be due again.
  @@index([status, dueAt])
  /// The same shape for `task.assigned`, whose window is the last few hours of assignments
  /// rather than the next few minutes of deadlines. `assignedAt` is null for almost every
  /// row ever written, which is what makes this one cheap.
  @@index([status, assignedAt])
}

// The sync/undo/feed substrate; seq is a strictly-increasing cursor (ADR-0019).
model Change {
  id          String       @id @default(cuid())
  seq         BigInt       @default(autoincrement())
  tripId      String
  actorUserId String
  entityType  String
  entityId    String
  action      ChangeAction
  before      Json?
  after       Json?
  createdAt   DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([tripId, seq])
}

// Facts about a real-world place, GLOBAL rather than trip-scoped (ADR-0166 §1/§4).
//
// The rule that draws the line against `Place`: **if two different trips could
// legitimately disagree about it, it is not enrichment.** An icon and a category are
// this trip's opinion and stay on `Place` (ADR-0147/0165); a summary, an image and
// opening hours are facts about the world and live here, read by every trip that
// references the same place.
//
// **No `tripId` and no FK to `Place`** — deliberately, and it is why enrichment is
// outside `ChangeService` (§6): there is no trip to write a `Change` against, one
// writer (the server) so no LWW, and no action anyone performed so nothing to undo.
// `Place` is untouched by this table's existence: no migration, no column moved.
model PlaceEnrichment {
  // Our own key, so Google is not the identity spine of a store whose whole purpose is
  // to not depend on Google — and so a coordless Place-lite (ADR-0147) is not stranded
  // forever. Adding an alias later is a column and an index, not a re-key.
  id String @id @default(cuid())

  // Alias columns, all nullable and all unique — the only things we query, which is why
  // they are columns and the values are not (§4).
  googlePlaceId String? @unique // the one Google field we may hold indefinitely (§1)
  wikidataQid   String? @unique // added when Wikidata matches; an alias, not the key
  osmRef        String? @unique // "node/123456"; likewise

  // Record<EnrichmentField, present | absent>, zod-validated by `enrichmentFieldsSchema`
  // in @waypoint/shared. One payload rather than a column per field because every value
  // carries ~6 facts of its own provenance, and that is a migration per field AND per
  // source for data nothing filters or joins on (§4).
  fields Json

  // The negative-cache clock (§6.4): when a pass last ran against this row at all,
  // whatever it found. Per-field miss timers live inside `fields`; this is the queryable
  // one, for finding rows worth revisiting.
  attemptedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The world's exchange rates (ADR-0184 §7) — global, server-owned, and outside
/// the change log for exactly the reasons ADR-0166 §6 gives for `PlaceEnrichment`:
/// no `tripId`, one writer (us), never mutated by a client, so there is no LWW to
/// arbitrate, no undo to offer and no per-trip ordering to keep. Writing one
/// worldwide fact into a trip-scoped change log would mean fanning it out as N
/// trip changes.
///
/// ONE ROW PER BASE, and in practice one row: a converter needs arbitrary pairs
/// and no free source quotes ~25,000 of them, so every pair is crossed through
/// the base (`crossRate` in @waypoint/shared). Storing the set rather than the
/// pairs is also what keeps this a fixed-size table forever.
///
/// No history. The `▲/▼` delta was dropped in §8, and it was the only reader a
/// previous set would have had — so the row is overwritten in place rather than
/// appended to, and the table cannot grow.
model FxRateSet {
  /// ISO-4217 base every rate is quoted against; the natural key, so an upsert
  /// needs no lookup and a second base (should one ever be added) is a row.
  base String @id

  /// Record<currencyCode, number> — units per one unit of `base`, base included
  /// at 1. JSON rather than a join table for the same reason enrichment's
  /// `fields` is: ~160 numbers nothing filters, sorts or joins on.
  rates Json

  /// **The source's own publication time**, which is what the UI renders as
  /// "as of" (§4). Distinct from `fetchedAt` on purpose: a set fetched minutes
  /// ago can be a day old and still be the current published set.
  publishedAt DateTime

  /// When the source says the next set will exist. This is what makes §4's
  /// refresh affordance exact — "a press could change the number" is
  /// `now > nextUpdateAt`, not a guess about which days are business days.
  nextUpdateAt DateTime

  /// Ours, for diagnostics and for bounding retries after a failed pass. Never
  /// rendered — showing it would be precise and wrong.
  fetchedAt DateTime

  /// Who published it, and where to link. Carried rather than hardcoded at a
  /// surface so a second provider is credited correctly without a UI change —
  /// the chosen source's terms require visible, linked attribution.
  provider    String
  providerUrl String
}

/// A device this user can be reached on (ADR-0197 §2). Control plane, not data plane:
/// no `tripId`, no `Change` row, no broadcast, never client-mutated beyond its own
/// create/delete — the same three reasons `PlaceEnrichment` sits outside `ChangeService`
/// (ADR-0166 §6). There is nothing here to undo and nothing to reconcile.
model PushSubscription {
  id String @id @default(cuid())

  userId String

  /// **The push service's own URL, and the row's real identity.** Unique because the
  /// endpoint already is: the browser issues one per (profile, origin, subscription), so
  /// inventing a device id of our own would be a second name for the same thing — and a
  /// re-subscribe after a key rotation would leave the old row addressable.
  endpoint String @unique

  /// The client's P-256 public key and auth secret, base64url as the browser hands them
  /// over. Not secrets of ours: they are the halves that let only this device decrypt the
  /// payload, and without them the endpoint is useless to us.
  p256dh String
  auth   String

  /// So a person can recognise the row in settings ("this phone" vs "the laptop").
  /// Nullable — a client that sends none still gets a working subscription.
  userAgent String?

  createdAt DateTime @default(now())

  /// Diagnostics, and the two facts a settings surface can honestly show. Deliberately
  /// NOT a failure counter: a `404`/`410` deletes the row outright (§10), because that is
  /// a subscription's normal death rather than an error to count.
  lastSentAt   DateTime?
  lastFailedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// **What was already sent** (ADR-0197 §3), and the whole of the epic's exactly-once
/// mechanism. Control plane, like `PushSubscription` above.
///
/// This table records the PAST, which is the half that cannot go stale — the deliberate
/// alternative to a queue of future jobs, which would be a second copy of a schedule
/// Postgres already holds (`Task.dueAt`, `Event.startsAt`) that every edit path would have
/// to keep honest.
///
/// The unique key IS the mechanism: the sweep inserts the row and sends inside one
/// transaction, so a unique violation means another tick — or another backend instance —
/// already has it. No leader election, no advisory lock, and nothing that assumes one
/// process.
model NotificationSend {
  id String @id @default(cuid())

  userId String

  /// ADR-0198's catalogue id (`task.due`, `event.hard.soon`, …). A String and NOT a Prisma
  /// enum, the same call `Task.derivedKey` makes: the kinds belong to the code that derives
  /// them, so a sixth kind is a code change and never a migration.
  kind String

  /// The task / event / trip the send is about.
  subjectId String

  /// **The instant the send was AIMED at**, bucketed to the minute — and this is the field
  /// that makes edits behave. Dedup on (whom, what, WHICH INSTANT) rather than (whom, what):
  /// a deadline moved from 18:00 to 20:00 is a new key, so it re-arms; a title edited is the
  /// same key, so nothing re-sends.
  fireKey String

  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, subjectId, fireKey])
  /// Also what enforces ADR-0198 §5's per-day cap, which is a count of this user's recent rows.
  @@index([userId, sentAt])
}

/// **A route we asked somebody else for, kept so we never ask again** (ADR-0205 §4) — the third
/// table of exactly this shape, after `PlaceEnrichment` (ADR-0166 §6) and `FxRateSet` (ADR-0180
/// §7), and their reasoning transfers verbatim: no `tripId`, one writer (us), never mutated by a
/// client. So there is no LWW to arbitrate, no undo to offer, no per-trip ordering to keep, and
/// **nothing here goes through `ChangeService`** — the one hard boundary in the backend, which
/// this sits outside of rather than making an exception to.
///
/// It does not violate ADR-0018/0027's ban on persisting derived state, and §4 says why: a route
/// is not derived from our data at all, it is an answer from outside that we would otherwise have
/// to re-ask. Nothing a person authored lives here, which is what licenses evicting it freely.
model RouteLeg {
  /// `routeLegKey(from, to, mode)` from `@waypoint/shared`, and the key is **directional on
  /// purpose**: one-way streets, turn restrictions and toll geometry make A→B and B→A different
  /// answers. One spelling of it, in the shared package, because the client's own Dexie table
  /// (ADR-0205 §7) reads what this writes — two spellings is a client that can never hit a row.
  key String @id

  /// Denormalised out of `key` so the row is legible and evictable without parsing its own id.
  /// **Coordinates, never a `placeId`**: a `Place` is trip-scoped (ADR-0147), so two trips that
  /// both save Senso-ji hold two rows and a `placeId` key would never hit across them (§4).
  mode    String
  fromLat Float
  fromLng Float
  toLat   Float
  toLng   Float

  /// Seconds and metres, matching `travelEstimateSchema`. `Float` rather than `Int` because
  /// `/route` answers fractional seconds and rounding at the boundary would make the same leg
  /// differ by which call fetched it — ADR-0206 §D3's ladder is what rounds, at the surface.
  durationSeconds Float
  distanceMeters  Float

  /// The drawable line, and **the precision travels with it** (ADR-0205 §1): decoded at 5 rather
  /// than Valhalla's 6, a Tokyo walk comes back as a well-formed pair of numbers ten times off,
  /// with no error and a line drawn nowhere. Null together — the matrix answers durations and no
  /// geometry at all, so most rows have no shape until something asks to draw one.
  shapeEncoded   String?
  shapePrecision Int?

  /// Who answered, so a provider swap (ADR-0205 §Y1) leaves evidence of which rows came from
  /// where instead of a silently mixed table.
  provider String

  /// **The provider's tileset date — ADR-0205 §Z5's invalidation signal**, which §4 said a route
  /// has and a clock does not. A walking route between two fixed points is invalidated by an OSM
  /// refresh and by nothing else, so this is what M12 evicts on rather than guessing a TTL.
  /// Nullable: a provider that will not state its vintage yields a row with no eviction handle,
  /// which still holds a correct estimate.
  tilesetAt DateTime?

  /// Provenance, **not an expiry** — there is no TTL to compare it against.
  computedAt DateTime @default(now())

  /// The only non-key query this table has: M12's eviction sweep on a tileset roll.
  @@index([tilesetAt])
}
